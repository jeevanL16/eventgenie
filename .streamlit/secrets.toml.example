# Streamlit Secrets Template for EventGenie
# Copy to .streamlit/secrets.toml for local testing, or paste into
# Streamlit Community Cloud Settings -> Secrets for deployment.

LLM_PROVIDER = "router"
LLM_CHAIN = "groq,gemini"

# Groq API key (free tier via https://console.groq.com)
GROQ_API_KEY = "your-groq-api-key-here"
GROQ_MODEL = "qwen/qwen3.8-27b"

# Google Gemini API key (free tier via https://aistudio.google.com)
GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-flash-lite-latest"

