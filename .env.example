# LLM Provider: "router", "gemini", "groq", or "ollama"
LLM_PROVIDER=router

# Ordered failover chain for LLM router (comma-separated: groq, gemini, ollama)
LLM_CHAIN=groq,gemini,ollama

# Google Gemini API key (free tier via Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Groq API key (free tier via groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama local configuration (for offline dev and evals)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
